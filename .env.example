# Copy to .env and fill in. Every value here has a safe fallback (see
# README) so the server boots and the full demo works with nothing set.

PORT=4000

# Optional. Without this, the server runs in in-memory mode: the digital
# twin still runs and every route still works, but readings/insights are
# not persisted and reset on restart.
MONGO_URI=

# Optional. Without this, all three /api/ai/* routes fall back to the same
# deterministic, scenario-grounded heuristics the frontend used standalone
# (see services/groqService.js) instead of calling out to Groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of allowed CORS origins for the frontend dev server.
CORS_ORIGIN=http://localhost:5173
